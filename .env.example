# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets — never commit real values, never share in chat.
# Set these directly in Vercel's dashboard (Project Settings -> Environment Variables)
# or in a local .env.local file that stays out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Text-generation AI (JD/resume parsing, pipeline summaries, Smart Screen.ai,
# Job Postings.ai polish, Offer.ai polish). Optional model override: OPENAI_MODEL
# (defaults to gpt-4o-mini). Each caller degrades to a visible error, never a
# silent failure, if this is unset.
OPENAI_API_KEY=

# Optional — degrades gracefully (logs instead of sending) if unset.
RESEND_API_KEY=
